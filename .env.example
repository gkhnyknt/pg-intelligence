# Bu dosyayı .env olarak kopyalayın ve değerleri doldurun. .env git'e eklenmez.

# Panel giriş bilgileri (APP_PASSWORD boşsa her açılışta rastgele şifre üretilip konsola yazılır)
APP_USER=admin
APP_PASSWORD=

# 1. Sunucu
DB1_NAME=Local Server
DB1_HOST=localhost
DB1_PORT=5432
DB1_USER=postgres
DB1_PASSWORD=
DB1_DBNAME=postgres
DB1_LOG_PATH=

# 2. Sunucu
DB2_NAME=Production Server
DB2_HOST=
DB2_PORT=5432
DB2_USER=postgres
DB2_PASSWORD=
DB2_DBNAME=postgres

# Uygulama Portu
API_PORT=8000
